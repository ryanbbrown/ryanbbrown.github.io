#!/bin/bash
# Double-click this file to sync content and deploy
# Copy to Desktop and update paths as needed

cd /path/to/ryanbbrown.github.io

./update-symlinks.sh /path/to/obsidian-vault-folder

git add -A

if ! git diff --cached --quiet; then
    added=$(git diff --cached --diff-filter=A --name-only | wc -l | tr -d ' ')
    modified=$(git diff --cached --diff-filter=M --name-only | wc -l | tr -d ' ')
    deleted=$(git diff --cached --diff-filter=D --name-only | wc -l | tr -d ' ')

    parts=()
    [ "$added" -gt 0 ] && parts+=("add new pages")
    [ "$modified" -gt 0 ] && parts+=("update existing")
    [ "$deleted" -gt 0 ] && parts+=("remove pages")

    msg="content: $(IFS=', '; echo "${parts[*]}")"

    git commit -m "$msg"
    git push
fi

osascript -e 'tell application "Terminal" to close front window' &
